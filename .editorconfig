# editor and formatter (Prettier and Black).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,md,yml,yaml,lua,tex}]
indent_size = 2

# the generated data files are written with 4 spaces
[*.json]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
